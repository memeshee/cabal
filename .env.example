# Copy to .env for local development. Never commit .env.
NEAR_NETWORK=testnet
CABAL_CONTRACT=your-contract.testnet
HOUSE_ACCOUNT=your-house.testnet
# If unset, the key is read from ~/.near-credentials/testnet/<HOUSE_ACCOUNT>.json
# HOUSE_SECRET_KEY=ed25519:...
# Optional: mixed into the wallet-derivation master (leave unset to derive from the house key alone)
# MASTER_SECRET=
SLOTS=3
# Dialogue for the KOLs. All optional: with none set, the KOLs use scripted lines.
# NEAR_AI_API_KEY=            # NEAR AI Cloud (TEE-hosted inference), used first when set
# NEAR_AI_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# LLM_BASE_URL=               # any OpenAI-compatible endpoint, used if NEAR AI fails
# LLM_API_KEY=
# LLM_MODEL=
